--- !u!114 &1762225912
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1762225907}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 093f26ad11c4e0240bd58481ce44876f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NetworkRelayUIManager
  quickJoin_btn: {fileID: 29131865}
  maxStage: 1
  tooltip_text: {fileID: 2037510024}
  tooltipList:
  - "\uC5D0\uD14C\uB974\uC758 \uC0DD\uBA85\uB825: \uC5D0\uD14C\uB974\uC758 \uC815\uB839\uB4E4\uC740
    \uC778\uAC04\uC774 \uB290\uB07C\uB294 \uAC10\uC815 \uC5D0\uB108\uC9C0\uB97C \uC591\uBD84
    \uC0BC\uC544 \uC0B4\uC544\uAC11\uB2C8\uB2E4. "
  - "\uD574\uACB0\uC0AC\uC758 \uB4F1\uC7A5: \uC778\uAC04\uC758 \uBD80\uC815\uC801\uC778
    \uAC10\uC815\uC774 \uACFC\uB3C4\uD574\uC9C0\uBA74, \uC5D0\uD14C\uB974\uB97C \uC9C0\uD0A4\uAE30
    \uC704\uD574 \uB9C8\uC74C\uD574\uACB0\uC0AC\uAC00 \uCD9C\uB3D9\uD569\uB2C8\uB2E4. "
  - "\uC815\uB839\uC758 \uC704\uAE30: \uBD80\uC815\uC801\uC778 \uAC10\uC815\uC5D0
    \uC624\uB798 \uB178\uCD9C\uB41C \uC815\uB839\uC740 \uADF8 \uC0C9\uC5D0 \uBB3C\uB4E4\uC5B4
    \uC874\uC7AC\uAC00 \uC0AC\uB77C\uC9C8\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4. "
  - "\uC5F0\uACB0\uB41C \uC138\uACC4: \uC778\uAC04 \uC138\uACC4\uC5D0 \uD070 \uC0AC\uAC74\uC774
    \uC0DD\uAE30\uBA74 \uC5D0\uD14C\uB974\uB3C4 \uC694\uB3D9\uCE69\uB2C8\uB2E4. \uC608\uB97C
    \uB4E4\uBA74... \uC9D1\uAC12 \uD3ED\uB4F1 \uAC19\uC740 \uAC83 \uB9D0\uC774\uC8E0!"
  - "\uBC14\uB798\uC9C4 \uAE30\uC5B5\uC758 \uCD94\uC801: \uC815\uB839\uB4E4\uC740
    \uC2DC\uAC04\uC758 \uD750\uB984\uC774 \uC544\uB2CC, \uAC10\uC815\uC774 \uAC15\uD558\uAC8C
    \uB9FA\uD78C '\uAE30\uC5B5\uC758 \uD30C\uD3B8'\uC744 \uC774\uC815\uD45C \uC0BC\uC544
    \uC778\uAC04\uC758 \uB0B4\uBA74\uC5D0 \uC811\uC18D\uD569\uB2C8\uB2E4."
  - "\uBCF4\uC774\uC9C0 \uC54A\uB294 \uAD00\uCC30\uC790: \uC778\uAC04\uC740 \uC815\uB839\uC744
    \uBCFC \uC218 \uC5C6\uC9C0\uB9CC, \uC815\uB839\uB4E4\uC740 \uC778\uAC04 \uACC1\uC5D0\uC11C
    \uAC10\uC815\uC758 \uD750\uB984\uC744 \uC9C0\uCF1C\uBCF4\uBA70 \uAC00\uC7A5 \uD544\uC694\uD55C
    \uC0C9\uAE54\uC774 \uBB34\uC5C7\uC778\uC9C0 \uCC3E\uC544\uB0C5\uB2C8\uB2E4."
  - "\uAE30\uC5B5\uC758 \uC18C\uC6A9\uB3CC\uC774: \uC815\uB839\uB4E4\uC740 \uC5D0\uD14C\uB974\uC5D0
    \uC0DD\uAE34 \uAC10\uC815\uC758 \uC18C\uC6A9\uB3CC\uC774\uB97C \uD1B5\uD574 \uC778\uAC04\uC758
    \uAE30\uC5B5 \uC18D\uC73C\uB85C \uC9C1\uC811 \uB6F0\uC5B4\uB4E4\uC5B4 \uBB38\uC81C\uB97C
    \uD574\uACB0\uD569\uB2C8\uB2E4."
  - "\uAC10\uC815\uC758 \uC911\uD654: \uB108\uBB34 \uAC15\uD55C \uC6D0\uC0C9\uC758
    \uAC10\uC815\uC740 \uC704\uD5D8\uD569\uB2C8\uB2E4. \uC815\uB839\uC740 \uC790\uC2E0\uC758
    \uC0C9\uC744 \uB354\uD574 \uB0A0\uCE74\uB85C\uC6B4 \uAC10\uC815\uC744..."
  - "\uAE30\uC5B5 \uB354\uB4EC\uAE30: \uB9C8\uC74C\uD574\uACB0\uC0AC\uB294 \uC789\uD06C\uCC98\uB7FC
    \uBC88\uC9C4 \uAE30\uC5B5\uC758 \uD30C\uD3B8\uC744 \uB354\uB4EC\uC5B4 \uC5C7\uAC08\uB9B0
    \uAC10\uC815\uC744 \uC870\uC728\uD569\uB2C8\uB2E4. "
  - "\uD68C\uD53C\uD558\uC9C0 \uC54A\uB294 \uB9C8\uC74C: \uC544\uD508 \uAE30\uC5B5\uC744
    \uC678\uBA74\uD558\uC9C0 \uB9C8\uC138\uC694. \uADF8 \uAE30\uC5B5 \uC18D\uC5D0
    \uC9C4\uC2EC\uC5D0 \uB3C4\uB2EC\uD560 \uC5F4\uC1E0\uAC00 \uC228\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC194\uC9C1\uD568\uC758 \uD798: \uB54C\uB85C\uB294 \uC11C\uB85C\uC5D0\uAC8C
    \uAC74\uB124\uB294 \uC194\uC9C1\uD55C \uB9D0 \uD55C\uB9C8\uB514\uAC00 \uBAA8\uB4E0
    \uAC83\uC744 \uD574\uACB0\uD569\uB2C8\uB2E4. "
  - "\uAE30\uB2E4\uB9BC\uC758 \uBBF8\uD559: \uAC10\uC815\uC774 \uC55E\uC124 \uB54C\uB294
    \uC7A0\uC2DC \uBA48\uCDB0\uBCF4\uC138\uC694. \uD30C\uD2B8\uB108\uC640 \uBCF4\uD3ED\uC744
    \uB9DE\uCD94\uB294 \uAC83\uC774 '\uC9C4\uC2EC'\uC5D0 \uB2FF\uB294 \uAC00\uC7A5
    \uBE60\uB978 \uAE38\uC785\uB2C8\uB2E4."
  - "\uB3D9\uAE30\uD654\uB41C \uCE58\uC720: \uC815\uB839\uB4E4\uC774 \uAE30\uC5B5
    \uC18D\uC5D0\uC11C \uAC10\uC815\uC744 \uAC08\uBB34\uB9AC\uD558\uBA74, \uD604\uC2E4\uC758
    \uC778\uAC04\uB4E4\uC740 \uC6D0\uC778 \uBAA8\uB97C \uD3C9\uC628\uD568\uACFC \uD568\uAED8
    \uC0C8\uB85C\uC6B4 \uC6A9\uAE30\uB97C \uC5BB\uAC8C \uB429\uB2C8\uB2E4."
  - "\uC5D0\uD14C\uB974\uC758 \uD68C\uBCF5: \uC778\uAC04\uC758 \uB9C8\uC74C\uC774
    \uBCF4\uB77C\uC0C9\uC73C\uB85C \uBB3C\uB4E4\uBA74, \uC815\uB839\uB4E4\uC758 \uC138\uACC4
    \uC5D0\uD14C\uB974\uB3C4 \uB2E4\uC2DC \uC0DD\uBA85\uB825\uC744 \uC5BB\uC2B5\uB2C8\uB2E4."
  - "\uB2F9\uC2E0 \uACC1\uC758 \uB204\uAD70\uAC00: \uB9C8\uC8FC\uD558\uAE30 \uB450\uB824\uC6B4
    \uAC10\uC815\uC774 \uC788\uB098\uC694? \uAC71\uC815 \uB9C8\uC138\uC694. \uB2F9\uC2E0\uC758
    \uACC1\uC5D0\uB294 \uD56D\uC0C1 \uB9C8\uC74C\uD574\uACB0\uC0AC\uAC00 \uD568\uAED8\uD558\uB2C8\uAE4C\uC694. "
  - "\uB2A6\uC9C0 \uC54A\uC740 \uD6C4\uD68C: \uC21C\uAC04\uC758 \uAC10\uC815\uC5D0
    \uD729\uC4F8\uB824 \uD6C4\uD68C\uD558\uACE0 \uC788\uB098\uC694? \uC544\uC9C1
    \uB2A6\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC2DC\uC791\uD574\uBCF4\uC138\uC694.
    \uBA4B\uC9C4 \uC77C: \uD0C0\uC778\uC758 \uAC10\uC815\uC744 \uD5E4\uC544\uB9AC\uACE0
    \uC790\uC2E0\uC758 \uB9C8\uC74C\uC744 \uB4E4\uC5EC\uB2E4\uBCF4\uB294 \uB2F9\uC2E0\uC740
    \uC815\uB9D0 \uBA4B\uC9C4 \uC0AC\uB78C\uC785\uB2C8\uB2E4."
